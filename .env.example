# Copy to .env and fill in. Never commit .env.

# Anthropic API key (only needed for live mode; replay mode works without it)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for interview + code generation (current default Claude model)
XLAGENT_MODEL=claude-opus-5-5

# Effort level passed as output_config.effort (low | medium | high | xhigh | max)
XLAGENT_EFFORT=high

# 1 = route refused requests to a fallback model server-side (beta), 0 = off
XLAGENT_REFUSAL_FALLBACK=1

# 1 = replay recorded responses from fixtures (no API key, no network)
XLAGENT_REPLAY=1

# 1 = record every live model call into a cassette under XLAGENT_RECORD_DIR
XLAGENT_RECORD=0
XLAGENT_RECORD_DIR=recorded_cassettes

# Sandbox timeout per script run, in seconds
XLAGENT_SANDBOX_TIMEOUT=60

# Where the API keeps job folders
XLAGENT_WORK_DIR=.xlagent_jobs
